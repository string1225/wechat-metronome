<view class="page-shell {{focusMode ? 'is-focused' : ''}}">
  <view class="header" wx:if="{{!focusMode}}">
    <view class="brand"><image src="/assets/drum-practice-assistant-avatar.jpg" mode="aspectFill"/><view><text class="eyebrow">DAILY DRUM PRACTICE</text><view class="brand-title">把节奏，练进身体里。</view></view></view>
    <button class="text-button" data-sheet="settings" bindtap="openSheet">声音设置</button>
  </view>
  <view class="tempo-panel" wx:if="{{!focusMode}}">
    <view class="tempo-top"><view class="tempo-value"><input type="number" value="{{bpm}}" bindblur="tempoInput" bindconfirm="tempoInput" maxlength="3"/><text>BPM</text></view><view class="tempo-side"><text>4/4 拍</text><button bindtap="tapTempo">轻点测速 TAP</button></view></view>
    <view class="tempo-bottom"><button data-step="-5" bindtap="changeBpm">−5</button><button data-step="-1" bindtap="changeBpm">−1</button><view class="beat-lights"><view wx:for="{{beats}}" wx:key="*this" class="beat-light {{currentBeat == index && isPlaying ? 'active' : ''}} {{index == 0 ? 'downbeat' : ''}}"><text>{{item}}</text></view></view><button data-step="1" bindtap="changeBpm">＋1</button><button data-step="5" bindtap="changeBpm">＋5</button></view>
  </view>
  <view class="main-tabs" wx:if="{{!focusMode}}">
    <button class="{{section == 'groove' ? 'selected' : ''}}" data-section="groove" bindtap="selectSection">套鼓律动</button>
    <button class="{{section == 'basics' ? 'selected' : ''}}" data-section="basics" bindtap="selectSection">基本功</button>
    <button class="{{section == 'click' ? 'selected' : ''}}" data-section="click" bindtap="selectSection">节拍器</button>
  </view>
  <view class="basic-tabs" wx:if="{{section == 'basics' && !focusMode}}"><button wx:for="{{basics}}" wx:key="id" class="{{mode == item.id ? 'selected' : ''}}" data-mode="{{item.id}}" bindtap="selectBasic">{{item.name}}</button></view>
  <view class="exercise-heading" wx:if="{{mode != 'click'}}">
    <view class="heading-copy"><text class="eyebrow">{{categoryName}} / {{mode == 'continuous' ? '保持速度，改变细分' : '4/4 · 一小节练透'}}</text><view class="exercise-title">{{mode == 'continuous' ? activeRoutine.name : activePattern.name}}</view></view>
    <button class="choose-button" data-sheet="library" bindtap="openSheet" wx:if="{{!focusMode}}">换练习 ›</button>
  </view>
  <view wx:if="{{mode == 'groove' || mode == 'single' || mode == 'rhythm'}}" class="score-card">
    <view class="score-toolbar"><view class="view-tabs"><button class="{{viewMode == 'score' ? 'selected' : ''}}" data-view="score" bindtap="selectView">五线谱</button><button class="{{viewMode == 'grid' ? 'selected' : ''}}" data-view="grid" bindtap="selectView">节奏网格</button></view><button class="text-button" bindtap="toggleFocus">{{focusMode ? '退出专注' : '放大练习'}}</button></view>
    <view class="notation-row" wx:if="{{viewMode == 'score'}}"><view class="profile-tabs"><button class="{{profile == 'academic' ? 'selected' : ''}}" data-profile="academic" bindtap="selectProfile">学院派 · 线位</button><button class="{{profile == 'popular' ? 'selected' : ''}}" data-profile="popular" bindtap="selectProfile">流行派 · 间位</button></view><button class="text-button" data-sheet="legend" bindtap="openSheet">图例</button></view>
    <drum-score wx:if="{{viewMode == 'score'}}" id="drum-score" pattern="{{activePattern}}" profile="{{profile}}" active-step="{{currentStep}}" muted="{{muted}}" large="{{focusMode}}"/>
    <view class="grid-shell" wx:else>
      <view class="track-labels"><view class="grid-label">数拍</view><view class="grid-label" wx:for="{{activePattern.tracks}}" wx:key="key">{{item.short}}</view></view>
      <scroll-view class="pattern-scroll" scroll-x="true" scroll-left="{{gridScrollLeft}}" enhanced="true" show-scrollbar="false"><view style="width: {{activePattern.gridWidth}}rpx;">
        <view class="grid-row"><view wx:for="{{activePattern.ruler}}" wx:key="step" class="grid-cell ruler {{currentStep == item.step ? 'current' : ''}}">{{item.label}}</view></view>
        <view wx:for="{{activePattern.tracks}}" wx:for-item="track" wx:key="key" class="grid-row {{muted[track.key] ? 'muted' : ''}}"><view wx:for="{{track.cells}}" wx:key="step" class="grid-cell {{item.hit ? 'hit' : ''}} {{item.isBeat ? 'beat-start' : ''}} {{currentStep == item.step ? 'current' : ''}}">{{item.label}}</view></view>
      </view></scroll-view>
    </view>
    <view class="score-footer"><text>{{mode == 'groove' ? '动 = 底鼓＋踩镲 · 打 = 军鼓＋踩镲' : activePattern.countPattern}}</text><text>♩ = {{bpm}}</text></view>
  </view>
  <view class="routine-card" wx:if="{{mode == 'continuous'}}">
    <text class="eyebrow">当前段落</text><view class="stage-readout">{{stageName}}<text>{{stageBar}} / {{stageBars}} 小节</text></view>
    <view class="stage-progress"><view wx:for="{{activeRoutine.stages}}" wx:key="id" class="{{stageIndex == index ? 'active' : ''}} {{stageIndex > index ? 'done' : ''}}"></view></view>
    <view class="next-stage">下一段 <text>{{nextStageName}}</text></view><view class="routine-description">{{activeRoutine.description}}</view>
  </view>
  <view class="click-card" wx:if="{{mode == 'click'}}"><text class="eyebrow">先把每一拍打稳</text><view class="click-title">留一点空间，听见节奏。</view><view class="large-beats"><view wx:for="{{beats}}" wx:key="*this" class="{{currentBeat == index && isPlaying ? 'active' : ''}}">{{item}}</view></view><text class="hint">四分音符 · 第一拍重音</text></view>
  <view class="practice-options" wx:if="{{mode != 'click' && mode != 'continuous' && !focusMode}}">
    <view class="option-label">这次练几小节</view><view class="loop-options"><button wx:for="{{loopChoices}}" wx:key="*this" class="{{loopBars == item ? 'selected' : ''}}" data-bars="{{item}}" bindtap="selectLoop">{{item == 0 ? '持续循环' : item + ' 小节'}}</button></view>
  </view>
  <view class="track-mixer" wx:if="{{mode == 'groove' && !focusMode}}"><view class="option-label">分轨练习 <text>点击可静音，自己补上这一声</text></view><view class="track-buttons"><button wx:for="{{activePattern.tracks}}" wx:key="key" class="{{muted[item.key] ? 'is-muted' : ''}}" data-key="{{item.key}}" bindtap="toggleTrack"><view class="track-indicator {{item.key}}"></view><view><text>{{item.label}}</text><text class="track-limb">{{muted[item.key] ? '已静音' : item.limb}}</text></view></button></view></view>
  <view class="coach-note" wx:if="{{mode != 'click' && !focusMode}}"><text class="coach-label">练习要点</text><text>{{mode == 'continuous' ? activeRoutine.focus : activePattern.focus}}</text></view>
  <view class="suggestion" wx:if="{{mode != 'click' && !focusMode}}"><button bindtap="useSuggestedTempo">用建议速度 {{mode == 'continuous' ? activeRoutine.defaultBpm : activePattern.defaultBpm}} BPM</button><text>准备拍 {{countIn ? '开' : '关'}}</text></view>
  <view class="audio-warning" wx:if="{{audioUnavailable}}">{{audioStatus}}</view>
  <view class="transport-dock"><view class="play-state"><view class="status-dot {{isPlaying ? 'active' : ''}}"></view><view><text class="phase">{{countInNum ? '预备 · ' + countInNum + ' / 4' : phase}}</text><text class="bar-status">{{focusMode ? bpm + ' BPM · ' : ''}}{{isPlaying && !countInNum ? '第 ' + currentBar + ' 小节' : '放松肩膀，保持呼吸'}}</text></view></view><button class="play-button {{isPlaying || isStarting ? 'playing' : ''}}" bindtap="togglePlay"><view class="{{isPlaying || isStarting ? 'stop-icon' : 'play-icon'}}"></view>{{isStarting ? '取消' : isPlaying ? '停止' : '开始练习'}}</button></view>
  <view class="sheet-backdrop" wx:if="{{sheet}}" bindtap="closeSheet" catchtouchmove="noop">
    <view class="sheet" catchtap="noop"><view class="sheet-handle"></view><view class="sheet-heading"><text>{{sheet == 'library' ? '今天练什么？' : sheet == 'legend' ? '读懂这张鼓谱' : '声音与练习设置'}}</text><button bindtap="closeSheet">完成</button></view>
      <scroll-view scroll-y="true" class="sheet-body">
        <block wx:if="{{sheet == 'library'}}"><view class="sheet-intro">{{mode == 'groove' ? '从分解到合奏，一步步建立手脚配合。' : '保持放松，先练均匀，再提高速度。'}}</view><button wx:for="{{library}}" wx:key="id" class="library-item {{selected[mode] == index ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectExercise"><view class="library-number">{{index + 1 < 10 ? '0' + (index + 1) : index + 1}}</view><view class="library-copy"><view>{{item.name}}</view><text>{{item.focus}}</text></view><text class="library-mark">{{selected[mode] == index ? '当前' : '›'}}</text></button></block>
        <block wx:elif="{{sheet == 'legend'}}"><view class="sheet-intro">当前：{{profile == 'academic' ? '学院派 · 线位版' : '流行派 · 间位版'}}。线与间从下往上数。</view><view class="legend-table"><view class="legend-row" wx:for="{{legend}}" wx:key="key"><text class="legend-symbol">{{item.symbol}}</text><text>{{item.label}}</text><text>{{item.position}} {{item.annotation}}</text></view></view><view class="legend-note">这是本应用的两套位置预设。不同教材的鼓谱可能不同，请以当前图例为准；切换谱位不会改变演奏内容。手部符干向上，底鼓符干向下。</view></block>
        <block wx:else>
          <view class="setting-row"><view><text>开始前数一小节</text><text class="setting-help">给拿鼓棒、准备姿势留出时间</text></view><switch checked="{{countIn}}" data-key="countIn" bindchange="changeSetting" color="#35735e"/></view>
          <view class="setting-row"><view><text>练习时叠加节拍器</text><text class="setting-help">独立节拍器模式始终保留拍点</text></view><switch checked="{{clickOn}}" data-key="clickOn" bindchange="changeSetting" color="#35735e"/></view>
          <view class="volume-label">鼓组音量 <text>{{drumVolume}}%</text></view><slider value="{{drumVolume}}" data-key="drumVolume" bindchange="changeVolume" activeColor="#35735e" block-size="20"/>
          <view class="volume-label">节拍器音量 <text>{{clickVolume}}%</text></view><slider value="{{clickVolume}}" data-key="clickVolume" bindchange="changeVolume" activeColor="#d8654e" block-size="20"/>
          <view class="setting-row"><view><text>音量增强</text><text class="setting-help">需要更清楚的参照时开启</text></view><switch checked="{{boost}}" data-key="boost" bindchange="changeSetting" color="#d8654e"/></view>
          <view class="volume-label">练习速度 <text>{{bpm}} BPM</text></view><slider min="40" max="220" value="{{bpm}}" bindchange="tempoInput" activeColor="#35735e" block-size="20"/>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
