<view class="page-shell">
  <view class="header">
    <view class="brand">
      <image src="/assets/drum-practice-assistant-avatar.jpg" mode="aspectFill"/>
      <text class="brand-title">架子鼓练习助手</text>
    </view>
    <view class="header-actions">
      <button class="text-button" data-sheet="settings" bindtap="openSheet">声音设置</button>
      <button class="text-button" bindtap="openTap">TAP 测速</button>
    </view>
  </view>

  <view class="tempo-panel">
    <view class="tempo-top">
      <view class="tempo-value"><input type="number" value="{{bpm}}" bindblur="tempoInput" bindconfirm="tempoInput" maxlength="3"/><text>BPM</text></view>
      <view class="beat-lights"><view wx:for="{{beats}}" wx:key="*this" class="beat-light {{currentBeat == index && isPlaying ? 'active' : ''}} {{index == 0 ? 'downbeat' : ''}}">{{item}}</view></view>
      <text class="time-signature">4/4</text>
    </view>
    <view class="tempo-bottom">
      <view class="tempo-adjust"><button data-step="-5" bindtap="changeBpm">−5</button><button data-step="-1" bindtap="changeBpm">−1</button></view>
      <view class="tempo-presets"><button wx:for="{{tempoPresets}}" wx:key="*this" class="{{bpm == item ? 'selected' : ''}}" data-bpm="{{item}}" bindtap="selectTempo">{{item}}</button></view>
      <view class="tempo-adjust"><button data-step="1" bindtap="changeBpm">＋1</button><button data-step="5" bindtap="changeBpm">＋5</button></view>
    </view>
  </view>

  <view class="main-tabs">
    <button class="{{section == 'click' ? 'selected' : ''}}" data-section="click" bindtap="selectSection">节拍器</button>
    <button class="{{section == 'basics' ? 'selected' : ''}}" data-section="basics" bindtap="selectSection">基本功</button>
    <button class="{{section == 'groove' ? 'selected' : ''}}" data-section="groove" bindtap="selectSection">套鼓律动</button>
  </view>

  <view class="basic-tabs" wx:if="{{section == 'basics'}}">
    <button wx:for="{{basics}}" wx:key="id" class="{{mode == item.id ? 'selected' : ''}}" data-mode="{{item.id}}" bindtap="selectBasic">{{item.name}}</button>
  </view>
  <view class="exercise-options {{mode == 'continuous' ? 'routine-options' : mode == 'rhythm' ? 'rhythm-options' : ''}}" wx:if="{{mode != 'click'}}">
    <view class="exercise-option" wx:for="{{library}}" wx:key="id"><button class="{{selected[mode] == index ? 'selected' : ''}}" data-index="{{index}}" bindtap="selectExercise">{{item.shortName}}</button></view>
  </view>

  <view class="control-row practice-options" wx:if="{{mode != 'click' && mode != 'continuous'}}">
    <text class="control-label">小节</text>
    <view class="loop-options"><button wx:for="{{loopChoices}}" wx:key="*this" class="{{loopBars == item ? 'selected' : ''}}" data-bars="{{item}}" bindtap="selectLoop">{{item == 0 ? '循环' : item}}</button></view>
  </view>
  <view class="control-row track-mixer" wx:if="{{mode == 'groove'}}">
    <text class="control-label">分轨</text>
    <view class="track-buttons">
      <button wx:for="{{activePattern.tracks}}" wx:key="key" class="{{muted[item.key] ? 'is-muted' : ''}}" data-key="{{item.key}}" bindtap="toggleTrack" aria-label="{{item.gridLabel + (muted[item.key] ? '已静音，点击开启' : '已开启，点击静音')}}">
        <view class="track-indicator {{item.key}}"></view><text>{{item.gridLabel}}</text><text class="mute-label" wx:if="{{muted[item.key]}}">关</text>
      </button>
    </view>
  </view>

  <view class="routine-card" wx:if="{{mode == 'continuous'}}">
    <view class="routine-status">
      <view class="stage-readout">{{stageName}}<text>{{stageBar}} / {{stageBars}} 小节</text></view>
      <view class="next-stage">下一段 <text>{{nextStageName}}</text></view>
    </view>
    <view class="stage-progress"><view wx:for="{{activeRoutine.stages}}" wx:key="id" class="{{stageIndex == index ? 'active' : ''}} {{stageIndex > index ? 'done' : ''}}"></view></view>
  </view>

  <view wx:if="{{mode != 'click'}}" class="score-card">
    <view class="score-toolbar">
      <view class="display-tabs">
        <button class="{{viewMode == 'grid' ? 'selected' : ''}}" data-display="grid" bindtap="selectDisplay">节奏网格</button>
        <button class="{{viewMode == 'score' ? 'selected' : ''}}" data-display="score" bindtap="selectDisplay">五线谱</button>
      </view>
      <button class="legend-button" wx:if="{{viewMode == 'score'}}" data-sheet="legend" bindtap="openSheet">图例</button>
    </view>
    <drum-score wx:if="{{viewMode == 'score'}}" id="drum-score" pattern="{{activePattern}}" active-step="{{currentStep}}" muted="{{muted}}"/>
    <view class="grid-shell" wx:else>
      <view class="track-labels">
        <view class="grid-label">数拍</view><view class="grid-label" wx:for="{{activePattern.tracks}}" wx:key="key">{{item.gridLabel}}</view>
      </view>
      <scroll-view class="pattern-scroll" scroll-x="true" scroll-left="{{gridScrollLeft}}" enhanced="true" show-scrollbar="false">
        <view style="width: {{activePattern.gridWidth}}rpx;">
          <view class="grid-row"><view wx:for="{{activePattern.ruler}}" wx:key="step" class="grid-cell ruler {{currentStep == item.step ? 'current' : ''}}">{{item.label}}</view></view>
          <view wx:for="{{activePattern.tracks}}" wx:for-item="track" wx:key="key" class="grid-row {{muted[track.key] ? 'muted' : ''}}">
            <view wx:for="{{track.cells}}" wx:key="step" class="grid-cell {{item.hit ? 'hit' : ''}} {{item.isBeat ? 'beat-start' : ''}} {{currentStep == item.step ? 'current' : ''}}">{{item.label}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="click-card" wx:if="{{mode == 'click'}}">
    <view class="large-beats"><view wx:for="{{beats}}" wx:key="*this" class="{{currentBeat == index && isPlaying ? 'active' : ''}}">{{item}}</view></view>
    <text class="hint">四分音符 · 第一拍重音</text>
  </view>
  <view class="audio-warning" wx:if="{{audioUnavailable}}">{{audioStatus}}</view>

  <view class="transport-dock">
    <view class="play-state"><view class="status-dot {{isPlaying ? 'active' : ''}}"></view><view>
      <text class="phase">{{countInNum ? '预备 ' + countInNum + ' / 4' : phase}}</text>
      <text class="bar-status">{{isPlaying && !countInNum ? '第 ' + currentBar + ' 小节 · ' : ''}}{{bpm}} BPM</text>
    </view></view>
    <button class="play-button {{isPlaying || isStarting ? 'playing' : ''}}" bindtap="togglePlay"><view class="{{isPlaying || isStarting ? 'stop-icon' : 'play-icon'}}"></view>{{isStarting ? '取消' : isPlaying ? '停止' : '开始'}}</button>
  </view>

  <view class="tap-backdrop" wx:if="{{sheet == 'tap'}}" bindtap="closeSheet" catchtouchmove="noop">
    <view class="tap-dialog" catchtap="noop">
      <view class="sheet-heading"><text>TAP 测速</text><button bindtap="closeSheet">关闭</button></view>
      <view class="tap-instructions">跟随音乐，每一拍点一下 TAP。<text>连续点 4 次以上，测速更稳定。</text></view>
      <view class="tap-result"><text class="tap-bpm">{{tapBpm || '—'}}</text><text>BPM</text></view>
      <button class="tap-pad" hover-class="tap-pad-active" hover-stay-time="80" bindtap="tapTempo" aria-label="跟随节拍拍击测速">TAP</button>
      <view class="tap-status">{{tapCount == 0 ? '点击开始测速' : tapCount == 1 ? '再点一下，计算速度' : '已点 ' + tapCount + ' 次'}}</view>
      <view class="tap-range" wx:if="{{tapBpm && (tapBpm < 40 || tapBpm > 220)}}">支持 40–220 BPM，请每拍点击一次</view>
      <view class="tap-actions"><button class="tap-reset" bindtap="resetTap">重新测速</button><button class="tap-apply" disabled="{{tapCount < 2 || tapBpm < 40 || tapBpm > 220}}" bindtap="applyTap">{{tapBpm ? '使用 ' + tapBpm + ' BPM' : '使用测速结果'}}</button></view>
    </view>
  </view>

  <view class="sheet-backdrop" wx:if="{{sheet && sheet != 'tap'}}" bindtap="closeSheet" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-heading"><text>{{sheet == 'legend' ? '鼓谱图例' : '声音设置'}}</text><button bindtap="closeSheet">完成</button></view>
      <scroll-view scroll-y="true" class="sheet-body">
        <block wx:if="{{sheet == 'legend'}}">
          <view class="sheet-intro">线、间从下往上数</view>
          <view class="legend-table"><view class="legend-row" wx:for="{{legend}}" wx:key="key"><text class="legend-symbol">{{item.symbol}}</text><text>{{item.label}}</text><text>{{item.position}}</text></view></view>
        </block>
        <block wx:else>
          <view class="setting-row"><text>一小节预备拍</text><switch checked="{{countIn}}" data-key="countIn" bindchange="changeSetting" color="#35735e"/></view>
          <view class="setting-row"><text>练习时叠加节拍器</text><switch checked="{{clickOn}}" data-key="clickOn" bindchange="changeSetting" color="#35735e"/></view>
          <view class="volume-label">鼓组音量 <text>{{drumVolume}}%</text></view><slider value="{{drumVolume}}" data-key="drumVolume" bindchange="changeVolume" activeColor="#35735e" block-size="20"/>
          <view class="volume-label">节拍器音量 <text>{{clickVolume}}%</text></view><slider value="{{clickVolume}}" data-key="clickVolume" bindchange="changeVolume" activeColor="#d8654e" block-size="20"/>
          <view class="setting-row"><text>音量增强</text><switch checked="{{boost}}" data-key="boost" bindchange="changeSetting" color="#d8654e"/></view>
          <view class="volume-label">速度 <text>{{bpm}} BPM</text></view><slider min="40" max="220" value="{{bpm}}" bindchange="tempoInput" activeColor="#35735e" block-size="20"/>
          <button wx:if="{{mode != 'click'}}" class="suggested-tempo" bindtap="useSuggestedTempo">建议速度 {{mode == 'continuous' ? activeRoutine.defaultBpm : activePattern.defaultBpm}} BPM</button>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
